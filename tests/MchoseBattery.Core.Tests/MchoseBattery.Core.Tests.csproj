<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- TrayApplicationContext derives from ApplicationContext; the test assembly must
         resolve that WinForms base type to compile the status-mapping tests. -->
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.10.0" />
    <PackageReference Include="MSTest.TestAdapter" Version="3.5.0" />
    <PackageReference Include="MSTest.TestFramework" Version="3.5.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\MchoseBattery.Core\MchoseBattery.Core.csproj" />
    <ProjectReference Include="..\..\src\MchoseBattery.Tray\MchoseBattery.Tray.csproj" />
  </ItemGroup>
</Project>
